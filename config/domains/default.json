{
  "name": "generic",
  "modules": {
    "feature":   {"cn": "功能开发", "en": "Feature Dev", "keywords": ["feat", "feature", "新增", "功能", "support"]},
    "backend":   {"cn": "后端 / 服务", "en": "Backend / API", "keywords": ["api", "backend", "server", "service", "db", "数据库", "sql"]},
    "frontend":  {"cn": "前端 / UI", "en": "Frontend / UI", "keywords": ["ui", "frontend", "页面", "组件", "样式", "css", "渲染"]},
    "test":      {"cn": "测试", "en": "Testing", "keywords": ["test", "测试", "回归", "断言", "guard"]},
    "cicd":      {"cn": "CI / CD", "en": "CI / CD", "keywords": ["ci", "build", "deploy", "pipeline", "发布", "release", "pack"]},
    "security":  {"cn": "安全", "en": "Security", "keywords": ["security", "sec", "安全", "auth", "越权", "token", "key"]},
    "docs":      {"cn": "文档", "en": "Docs", "keywords": ["docs", "doc", "文档", "readme"]},
    "refactor":  {"cn": "重构", "en": "Refactor", "keywords": ["refactor", "重构", "清理", "cleanup"]},
    "infra":     {"cn": "基础设施", "en": "Infra", "keywords": ["infra", "docker", "k8s", "config", "依赖", "deps", "migrate"]},
    "fix":       {"cn": "缺陷修复", "en": "Bug Fix", "keywords": ["fix", "修复", "bug", "hotfix"]}
  },
  "rules": {
    "security_late_frac": 0.6,
    "high_escape_ratio": 1.5,
    "big_commit_files": 8
  },
  "outcome_probes": [
    {"pattern": "perf|性能|体积|bundle|pack|启动耗时|latency|优化", "label": "完成 {n} 项性能 / 体积 / 启动耗时类优化"},
    {"pattern": "i18n|国际化|多语言|locale|翻译", "label": "完成 {n} 项国际化 / 多语言改造"},
    {"pattern": "无障碍|a11y|accessib", "label": "完成 {n} 项无障碍（a11y）改进"},
    {"pattern": "监控|埋点|telemetry|observab|dashboard|看板", "label": "补齐 {n} 项可观测性 / 埋点 / 看板能力"},
    {"pattern": "迁移|migrat|升级|upgrade", "label": "完成 {n} 项依赖 / 数据 / 平台迁移升级"}
  ],
  "other_cn": "其他 / 基础",
  "other_en": "Other / Foundation"
}
